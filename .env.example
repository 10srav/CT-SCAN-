# Quantum CT Sinogram Denoising - Environment Configuration
# Copy this file to .env and update values

# =============================================================================
# Backend Configuration
# =============================================================================

# Application
APP_NAME="Quantum CT Denoiser API"
APP_VERSION="1.0.0"
DEBUG=false

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://quantum:quantum@localhost:5432/quantum_ct

# Redis (for Celery task queue)
REDIS_URL=redis://localhost:6379

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# =============================================================================
# Quantum Configuration
# =============================================================================

# VQC Parameters
NUM_QUBITS=16
VQC_LAYERS=6
LEARNING_RATE=0.01

# Quantum Backend
QISKIT_BACKEND=aer_simulator

# =============================================================================
# Model Configuration
# =============================================================================

# Model paths
MODEL_DIR=./data/models
DEFAULT_MODEL=vqc_denoiser_v1.pt

# Training defaults
BATCH_SIZE=32
EPOCHS=100

# =============================================================================
# Frontend Configuration
# =============================================================================

# API URL (used by frontend)
VITE_API_URL=http://localhost:8000

# =============================================================================
# MLflow Tracking
# =============================================================================

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=quantum-ct-denoising

# =============================================================================
# Monitoring
# =============================================================================

# Prometheus
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# Sentry (optional)
# SENTRY_DSN=https://your-sentry-dsn

# =============================================================================
# External Services (optional)
# =============================================================================

# AWS (for cloud deployment)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2

# Slack Notifications (optional)
# SLACK_WEBHOOK_URL=

# =============================================================================
# Development
# =============================================================================

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Log level
LOG_LEVEL=INFO
